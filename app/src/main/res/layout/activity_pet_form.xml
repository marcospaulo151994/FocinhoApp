<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário de cadastro/edição de pet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.pets.PetFormActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- Nome (obrigatório) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nome_pet">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Espécie (obrigatória): lista suspensa ("exposed dropdown") -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_especie"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/hint_especie">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/campo_especie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Raça (opcional): lista suspensa com as raças da espécie escolhida -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_raca"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/hint_raca">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/campo_raca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sexo (obrigatório) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:text="@string/rotulo_sexo"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <RadioGroup
                android:id="@+id/grupo_sexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_macho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sexo_macho" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_femea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/sexo_femea" />
            </RadioGroup>

            <TextView
                android:id="@+id/texto_erro_sexo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/erro_sexo"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Data de nascimento: focusable=false impede o teclado; o toque abre um calendário -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_nascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/hint_nascimento"
                app:startIconDrawable="@drawable/ic_calendar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_nascimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Peso (opcional), com sufixo "kg" -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_peso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/hint_peso"
                app:suffixText="@string/sufixo_kg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_peso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789.,"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Observações (opcional, várias linhas) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_observacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_campos"
                android:hint="@string/hint_observacoes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_observacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_salvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_secao"
                android:text="@string/salvar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
